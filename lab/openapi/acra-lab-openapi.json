{
  "openapi": "3.1.0",
  "info": {"title": "ACRA Lab Sprint 3", "version": "0.3.0"},
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  },
  "paths": {
    "/health": {"get": {"operationId": "health", "responses": {"200": {}}}},
    "/api/v1/tenants/{tenant}/documents/{document_id}": {
      "get": {"operationId": "getDocumentV1", "parameters": [{"name":"tenant","in":"path","required":true},{"name":"document_id","in":"path","required":true}], "security":[{"bearerAuth":[]}], "responses":{"200":{},"403":{},"404":{}}},
      "patch": {"operationId": "updateDocumentV1", "parameters": [{"name":"tenant","in":"path","required":true},{"name":"document_id","in":"path","required":true}], "security":[{"bearerAuth":[]}], "responses":{"200":{},"403":{},"404":{}}}
    },
    "/api/v2/tenants/{tenant}/documents/{document_id}": {"get": {"operationId":"getDocumentV2","parameters":[{"name":"tenant","in":"path","required":true},{"name":"document_id","in":"path","required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{},"403":{}}}},
    "/api/v1/tenants/{tenant}/documents": {"get": {"operationId":"listDocuments","parameters":[{"name":"tenant","in":"path","required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{},"403":{}}}},
    "/api/v1/tenants/{tenant}/users/{user_id}": {"get": {"operationId":"getTenantUser","parameters":[{"name":"tenant","in":"path","required":true},{"name":"user_id","in":"path","required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{},"403":{}}}},
    "/api/v1/users/{user_id}": {"get": {"operationId":"getUser","parameters":[{"name":"user_id","in":"path","required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{},"403":{}}}},
    "/api/v1/tenants/{tenant}/documents/{document_id}/approve": {"post": {"operationId":"approveDocument","parameters":[{"name":"tenant","in":"path","required":true},{"name":"document_id","in":"path","required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{},"403":{}}}},
    "/api/v1/tenants/{tenant}/documents/{document_id}/comments": {"get": {"operationId":"listComments","parameters":[{"name":"tenant","in":"path","required":true},{"name":"document_id","in":"path","required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{},"403":{}}}},
    "/api/v1/search": {"get": {"operationId":"searchDocuments","parameters":[{"name":"tenant_id","in":"query","required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{},"403":{}}}}
  }
