      ],
      "pathRegex": "^/stress/v3/workflows/release/resources/release-[0-9]+/transition$",
      "priority": 100,
      "rules": {
        "transitions": [
          {
            "action": "PROPOSE",
            "from": "NEW",
            "to": "PENDING",
            "roles": [
              "author"
            ]
          },
          {
            "action": "APPROVE",
            "from": "PENDING",
            "to": "APPROVED",
            "roles": [
              "reviewer"
            ],
            "requiredTrueFields": [
              "approval"
            ]
          },
          {
            "action": "PUBLISH",
            "from": "APPROVED",
            "to": "LIVE",
            "roles": [
              "publisher"
            ],
            "requiredTrueFields": [
              "published"
            ]
          }
        ]
      }
